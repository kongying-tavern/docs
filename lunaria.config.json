{
  "$schema": "./node_modules/@lunariajs/core/config.schema.json",
  "outDir": "./dist/_translations",
  "ignoreKeywords": ["@ignore", "[ci]", "[format]"],
  "repository": {
    "name": "kongying-tavern/docs"
  },
  "defaultLocale": {
    "label": "简体中文",
    "lang": "zh"
  },
  "locales": [
    {
      "label": "English",
      "lang": "en"
    },
    {
      "label": "日本語",
      "lang": "ja"
    }
  ],
  "files": [
    {
      "location": "pages/**/*.md",
      "pattern": "pages/@lang/@path",
      "ignore": [
        "pages/public/**",
        "fr/",
        "pages/zh/frontmatter.md",
        "pages/zh/staff.md",
        "pages/zh/md-enhance-guide.md",
        "pages/zh/team.md",
        "pages/zh/announcement.md",
        "pages/zh/blog/[id].md"
      ],
      "type": "universal"
    }
  ]
}
