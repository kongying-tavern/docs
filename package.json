{
  "type": "module",
  "private": "true",
  "packageManager": "pnpm@12.3.4",
  "license": "MIT",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "vitepress",
    "dev:portless": "npx portless --app-port 5173 kydocs vitepress",
    "serve": "vitepress serve --base /docs/",
    "clean": "node -e \"require('node:fs').rmSync('./dist',{recursive:true,force:true,maxRetries:10})\"",
    "build": "pnpm build:vitepress",
    "build:fonts": "tsx ./scripts/buildFonts.ts",
    "build:vitepress": "vitepress build --base /docs/",
    "build:mpa": "vitepress build --mpa --base /docs/",
    "build:data": "pnpm use-data-env && pnpm use-data-env pnpm build:member",
    "build:member": "tsx ./scripts/refreshMemberListData.ts",
    "build:emoji": "tsx ./scripts/emojiLoader.ts",
    "site:preview": "vitepress build --base /",
    "lint": "eslint --cache . && pnpm lint:zh",
    "lint:eslint": "eslint --cache .",
    "lint:eslint:fix": "eslint --cache --fix .",
    "lint:md": "markdownlint \"**/*.md\"",
    "lint:zh": "node scripts/lintZh.mjs",
    "lint:zh:fix": "node scripts/lintZh.mjs --fix",
    "typecheck": "pnpm typecheck:ts && pnpm typecheck:vue",
    "typecheck:ts": "tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit --project tsconfig.vue.json",
    "test": "node scripts/runTests.mjs",
    "test:list": "node scripts/runTests.mjs --list",
    "test:fonts": "node scripts/runTests.mjs fonts",
    "test:forum": "node scripts/runTests.mjs forum",
    "test:shared": "node scripts/runTests.mjs shared",
    "test:forum:ui": "playwright test --config tests/e2e/playwright.config.ts",
    "test:forum:ui:list": "playwright test --config tests/e2e/playwright.config.ts --list",
    "typecheck:forum:ui": "tsc --noEmit --project tests/e2e/tsconfig.json",
    "test:theme": "node scripts/runTests.mjs shared theme",
    "test:theme:ui": "node --test tests/theme/swipe-actions/browser.test.mjs",
    "commit": "git-cz",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "lunaria:build": "lunaria build",
    "lunaria:preview": "lunaria preview",
    "up": "taze major -I",
    "use-data-env": "dotenv -e .env.data -c --",
    "init:locale": "tsx ./scripts/initLocale.ts"
  },
  "dependencies": {
