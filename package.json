{
  "type": "module",
  "private": "true",
  "packageManager": "pnpm@10.34.5",
  "license": "MIT",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "vitepress",
    "dev:portless": "npx portless --app-port 5173 kydocs vitepress",
    "serve": "vitepress serve --base /docs/",
    "clean": "node -e \"require('node:fs').rmSync('./dist',{recursive:true,force:true,maxRetries:10})\"",
    "build": "pnpm build:vitepress",
    "build:fonts": "tsx ./scripts/buildFonts.ts",
    "build:vitepress": "vitepress build --base /docs/",
    "build:mpa": "vitepress build --mpa --base /docs/",
    "build:data": "pnpm use-data-env && pnpm use-data-env pnpm build:member",
    "build:member": "tsx ./scripts/refreshMemberListData.ts",
    "build:emoji": "tsx ./scripts/emojiLoader.ts",
    "build:locales": "tsx ./scripts/mergeLocales.ts",
    "site:preview": "vitepress build --base /",
    "lint": "eslint --cache . && pnpm lint:zh",
    "lint:eslint": "eslint --cache .",
    "lint:eslint:fix": "eslint --cache --fix .",
    "lint:md": "markdownlint **/*.md",
    "lint:zh": "zhlint **/zh/**/*.md",
    "lint:zh:fix": "zhlint **/zh/**/*.md --fix",
    "typecheck": "tsc --noEmit",
    "test:fonts": "tsx --test scripts/font_subset/*.test.ts",
    "commit": "git-cz",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "lunaria:build": "lunaria build",
    "lunaria:preview": "lunaria preview",
    "up": "taze major -I",
    "use-data-env": "dotenv -e .env.data -c --"
  },
  "dependencies": {
    "@comark/markdown-it": "catalog:markdown",
    "@fingerprintjs/fingerprintjs": "catalog:frontend",
    "@iconify-json/ic": "catalog:frontend",
    "@iconify-json/logos": "catalog:frontend",
    "@iconify-json/lucide": "catalog:frontend",
    "@iconify-json/ph": "catalog:frontend",
    "@lunariajs/core": "catalog:build",
    "@mdit/plugin-abbr": "catalog:markdown",
    "@mdit/plugin-container": "catalog:markdown",
    "@mdit/plugin-demo": "catalog:markdown",
    "@mdit/plugin-figure": "catalog:markdown",
    "@mdit/plugin-img-size": "catalog:markdown",
    "@mdit/plugin-mark": "catalog:markdown",
    "@mdit/plugin-sub": "catalog:markdown",
    "@mdit/plugin-sup": "catalog:markdown",
    "@mdit/plugin-tasklist": "catalog:markdown",
    "@number-flow/vue": "catalog:frontend",
    "@pinia/colada": "^1.0.0",
    "@radix-icons/vue": "catalog:frontend",
    "@tiptap/core": "catalog:conflicts_editor_h3_4_4",
    "@tiptap/extension-character-count": "catalog:conflicts_editor_h3_4_4",
    "@tiptap/extension-link": "catalog:editor",
    "@tiptap/extension-mention": "catalog:conflicts_editor_h3_4_4",
    "@tiptap/extension-placeholder": "catalog:conflicts_editor_h3_4_4",
    "@tiptap/pm": "catalog:editor",
    "@tiptap/starter-kit": "catalog:conflicts_editor_h3_4_4",
    "@tiptap/suggestion": "catalog:editor",
    "@tiptap/vue-3": "catalog:conflicts_editor_h3_4_4",
    "@vueuse/core": "catalog:frontend",
