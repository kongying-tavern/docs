  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@commitlint/types": "catalog:dev",
    "@types/js-yaml": "catalog:types",
    "@types/lodash-es": "catalog:types",
    "@types/markdown-it": "catalog:types",
    "@types/markdown-it-attrs": "catalog:types",
    "@types/markdown-it-container": "catalog:types",
    "@types/markdown-it-footnote": "catalog:types",
    "@types/node": "catalog:types",
    "@unocss/eslint-plugin": "catalog:dev",
    "conventional-changelog-cli": "catalog:dev",
    "dotenv-cli": "catalog:dev",
    "eslint": "catalog:dev",
    "fontaine": "catalog:dev",
    "git-cz": "catalog:dev",
    "husky": "catalog:dev",
    "js-yaml": "catalog:utils",
    "lint-staged": "catalog:dev",
    "lodash-es": "catalog:frontend",
    "markdown-it": "catalog:markdown",
    "markdown-it-container": "catalog:markdown",
    "markdown-it-emoji": "catalog:markdown",
    "markdown-it-kbd-better": "catalog:markdown",
    "markdownlint-cli": "catalog:dev",
    "open-editor": "catalog:dev",
    "shadcn-vue": "^2.8.2",
    "stylelint": "catalog:dev",
    "stylelint-config-standard": "catalog:dev",
    "stylelint-config-standard-scss": "catalog:dev",
    "stylelint-order": "catalog:dev",
    "taze": "catalog:dev",
    "tsx": "catalog:build",
    "unlazy": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-vue-devtools": "catalog:dev",
    "vitepress-plugin-llms": "catalog:build",
    "vue-component-meta": "catalog:build",
    "zhlint": "catalog:dev"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,cjs,mts,cts}": "pnpm lint:eslint:fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  }
}
