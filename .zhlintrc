{
  "preset": "default",
  "rules": {
    "halfwidthPunctuation": "",
    "adjustedFullwidthPunctuation": "‘’",
    "spaceOutsideHalfQuote": false,
    "unifiedPunctuation": {
      "default": false,
      "「": [
        "「",
        "“"
      ],
      "」": [
        "」",
        "”"
      ]
    }
  }
}
