#!/bin/sh
# Stage-scoped eslint: lint, autofix, re-stage, fail fast.
# Runs eslint through bash so pnpm's Windows .cmd shims resolve reliably
# (lint-staged v17 spawns tasks via tinyexec without a shell -> ENOENT on
# node_modules/.bin/*.cmd under Windows), and chunks the file list to stay
# under the Windows CreateProcess command-line limit.
files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|vue|mjs|cjs|mts|cts|css|scss)$')
if [ -n "$files" ]; then
  echo "$files" | xargs -n 60 sh -c 'pnpm exec eslint --cache --fix "$@" || exit 255' sh
  [ $? -eq 0 ] || exit 1
  git add -u
fi