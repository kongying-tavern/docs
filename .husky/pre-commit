#!/bin/sh
# Stage-scoped eslint: lint, autofix, re-stage, fail fast.
# Runs eslint through bash so pnpm's Windows .cmd shims resolve reliably
# (lint-staged v17 spawns tasks via tinyexec without a shell -> ENOENT on
# node_modules/.bin/*.cmd under Windows), chunks the file list to stay
# under the Windows CreateProcess command-line limit, and avoids grep in
# pipelines (unreliable in the git hook environment on Windows).
git diff --cached --name-only --diff-filter=ACM | while IFS= read -r f; do
  case "$f" in
    *.js|*.ts|*.vue|*.mjs|*.cjs|*.mts|*.cts|*.css|*.scss) echo "$f" ;;
  esac
done > /tmp/hook-files.txt
if [ -s /tmp/hook-files.txt ]; then
  xargs -n 60 < /tmp/hook-files.txt sh -c 'pnpm exec eslint --cache --fix "$@" || exit 255' sh || exit 1
  git add -u
fi
