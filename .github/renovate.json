{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticPrefixChore",
    ":dependencyDashboard",
    ":enableVulnerabilityAlerts",
    "schedule:weekends"
  ],
  "ignoreDeps": ["@fingerprintjs/**"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "groupName": "vitepress",
      "matchPackageNames": ["vitepress", "@vitepress/**", "vitepress-**"]
    },
    {
      "groupName": "vite",
      "matchPackageNames": ["vite"]
    },
    {
      "groupName": "mdit",
      "matchPackageNames": ["@mdit/**"]
    },
    {
      "groupName": "markdown-it",
      "matchPackageNames": [
        "markdown-it",
        "markdown-it-**",
        "@types/markdown-it-**"
      ]
    },
    {
      "groupName": "unocss",
      "matchPackageNames": ["unocss", "unocss-**"]
    },
    {
      "groupName": "iconify",
      "matchPackageNames": ["@iconify-json/**"]
    },
    {
      "groupName": "major upgrades",
      "matchUpdateTypes": ["major"],
      "excludePackageNames": ["vitepress", "@vitepress/**", "vitepress-**"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "all other non-major",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "excludePackageNames": [
        "vite",
        "vitepress",
        "@vitepress/**",
        "vitepress-**"
      ],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessageAction": "update lockfile",
    "platformAutomerge": true
  }
}
